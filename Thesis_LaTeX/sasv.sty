%      \rule{\textwidth}{0.5pt}
  \def\ps@headings{%
      \let\@oddfoot\@empty\let\@evenfoot\@empty
%      \def\@evenhead{\bfseries\thepage \hfil\leftmark}%
%      \def\@evenhead{\bfseries\rightmark\hfil\thepage}%
%      \def\@oddhead{\bfseries\rightmark\hfil\thepage}%
      \def\@evenhead{
      \hbox to \textwidth{\bfseries\rightmark\hfil\thepage}
      \hspace*{-1.005\textwidth}{\raisebox{-6pt}{\rule{\textwidth}{0.5pt}}}
      }%
      \def\@oddhead{
      \hbox to \textwidth{\bfseries\rightmark\hfil\thepage}
      \hspace*{-1.005\textwidth}{\raisebox{-6pt}{\rule{\textwidth}{0.5pt}}}
      }%
      \let\@mkboth\markboth
    \def\chaptermark##1{%
      \markboth {{%
        \ifnum \c@secnumdepth >\m@ne
          \if@mainmatter
            \@chapapp\ \thechapter. \ %
          \fi
        \fi
        ##1}}{}}%
    \def\sectionmark##1{%
      \markright {{%
        \ifnum \c@secnumdepth >\z@
          \thesection. \ %
        \fi
        ##1}}}}

\def\btitle{\normalfont\Large\bfseries\thispagestyle{empty}}

\def\@makeschapterhead#1{%
  \vspace*{-37\p@}%
  {\parindent \z@ \centering%\raggedright
    \normalfont
    \interlinepenalty\@M
    \Huge \bfseries  #1\par\nobreak
    \vskip 127\p@
  }}

\widowpenalty=10000 \clubpenalty=10000 \hyphenpenalty=1000 \tolerance=1000
\lefthyphenmin=3 \righthyphenmin=3
