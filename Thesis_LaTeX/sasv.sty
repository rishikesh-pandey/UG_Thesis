%%%%%%%%%%%%%%%%%%%%%%%%%%%%% Page Layout Settings %%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Margins
% Top margin
\setlength\topmargin{69\p@}         % head margin
\addtolength\topmargin{-1in}        % subtract out the 1 inch driver margin

% Header
\settoheight\headheight{\small\hbox to \z@{\hss
  ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz\hss}}%
                                    % height of running head

\setlength\topskip{11\p@}           % height of first line of text
\setlength\headsep{46\p@}           % space below running head --
\addtolength\headsep{-\topskip}     %   base to base with first line of text

% Text area
\setlength\textwidth{156mm}          % text measure excluding margins

\setlength{\textheight}{215mm}    % 39 lines of text
\addtolength\textheight{\topskip}   %   - including the first line

% Footer
\setlength\footskip{40\p@}          % space above footer line
\setlength\maxdepth{.5\topskip}     % pages can be short or deep by half a line?

% Marginal paragraphs
%\setlength\marginparsep{8\p@}
%\setlength\marginparpush{6\p@}
%\setlength\marginparwidth{3.75pc}

% Double-column settings
%\setlength\columnsep{1pc}           % space between columns for
                                    %   double-column text
%\setlength\columnseprule{0\p@}      % width of rule between two columns

% Inside margins
\setlength{\oddsidemargin}{6pc}   % set inside margin for odd pages
\addtolength\oddsidemargin{-1in}    % subtract out the 1 inch driver margin
%\setlength\@tempdima{\paperwidth}   % calculate outside margin for even
%\addtolength\@tempdima{-\textwidth} %  pages
%\addtolength\@tempdima{-4.5pc}      %      = trim width - (textwidth
\setlength\evensidemargin{6pc} %      + inside margin)
\addtolength\evensidemargin{-1in}   % subtract out the 1 inch driver margin
